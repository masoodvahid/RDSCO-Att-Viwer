{
  "name": "rdsco-attendance-report-maker",
  "version": "1.0.0",
  "description": "RDSCO desktop attendance report maker",
  "main": "src/main/main.js",
  "author": "RDSCO",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build:css && electron .",
    "dev": "npm run build:css && electron .",
    "build:css": "tailwindcss -i ./src/renderer/input.css -o ./src/renderer/app.css --minify",
    "check": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/attendance.js && node --check src/main/jalali.js && node --check src/main/reports.js && node --check src/main/audit.js && node --check src/main/updater.js && node --check src/renderer/app.js",
    "test": "node scripts/smoke-test.js",
    "dist": "npm run build:css && electron-builder",
    "dist:win": "npm run build:css && electron-builder --win --x64",
    "dist:mac": "npm run build:css && electron-builder --mac --universal",
    "dist:linux": "npm run build:css && electron-builder --linux --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.0.0"
  },
  "build": {
    "appId": "com.rdsco.attendance",
    "productName": "RDSCO Attendance",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/input.css"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "masoodvahid",
        "repo": "rdsco_att_report_maker"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "RDSCO-Attendance-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "artifactName": "RDSCO-Attendance-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "RDSCO-Attendance-${version}-${arch}.${ext}"
    }
  }
}
