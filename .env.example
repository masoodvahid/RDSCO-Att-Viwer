APP_NAME="سامانه گزارش تردد RDSCO"
APP_ENV=production
APP_URL=https://attendance.example.com
APP_TIMEZONE=Asia/Tehran
APP_KEY=change-this-to-a-long-random-secret
SESSION_NAME=rdsco_att_session
SESSION_LIFETIME_MINUTES=120
MAX_UPLOAD_MB=20
JOB_TTL_HOURS=24

# Kavenegar OTP
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Local PDF engine. Example: /usr/bin/chromium or /usr/bin/google-chrome
PDF_BROWSER_PATH=/usr/bin/chromium
PDF_NO_SANDBOX=false
PDF_TIMEOUT_SECONDS=60

# Optional absolute path. Empty = <project>/storage
STORAGE_PATH=
